# Copy to .env (gitignored). Never commit real values.

# Must match the deployed Worker secret:
#   cd apps/worker && npx wrangler secret put JWT_SECRET
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Local developer account password (rotate via scripts/reset-dev-password.mjs)
DEV_PASSWORD=

# Playwright target. NEVER point at production.
E2E_BASE_URL=
