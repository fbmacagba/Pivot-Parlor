# Copy to .env (gitignored). Never commit real values.

# Must match the deployed Worker secret:
#   cd apps/worker && npx wrangler secret put JWT_SECRET
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Local developer account password (rotate via scripts/reset-dev-password.mjs)
DEV_PASSWORD=

# Playwright target — REQUIRED to run E2E (the config refuses to start
# without it). Point at a staging/preview deployment, NEVER production:
# production has E2E fixtures disabled, and these tests create real data.
# Staging API: https://pivot-parlor-api-staging.bmorris0565.workers.dev
E2E_BASE_URL=
