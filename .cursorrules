## ROUTING CONVENTIONS

### Remix route naming
- `_marketing._index.tsx`       → / (homepage)
- `_marketing.about.tsx`        → /about
- `_marketing.pricing.tsx`      → /pricing
- `_marketing.contact.tsx`      → /contact
- `_marketing.privacy.tsx`      → /privacy
- `_marketing.terms.tsx`        → /terms
- `_marketing.cookies.tsx`      → /cookies
- `admin.tsx`                   → /admin layout (requireRole admin)
- `admin.services.tsx`          → /admin/services
- `admin.staff.tsx`             → /admin/staff
- `admin.schedule.tsx`          → /admin/schedule
- `admin.bookings.tsx`          → /admin/bookings
- `admin.revenue.tsx`           → /admin/revenue
- `admin.settings.tsx`          → /admin/settings
- `dev.tsx`                     → /dev layout (requireRole developer)
- `$shopSlug.tsx`               → /:shopSlug layout (public shop site)
- `$shopSlug._index.tsx`        → /:shopSlug (shop homepage)
- `$shopSlug.book.tsx`          → /:shopSlug/book
- `api.chat.tsx`                → /api/chat (marketing chatbot proxy)

### Auth pattern (match exactly — do not invent your own)
```typescript
import { getSessionToken, requireRole } from "~/lib/auth";
import { createApiClient } from "~/lib/api";

export async function loader({ request, context }: LoaderFunctionArgs) {
  const env = context.env as { API_URL: string };
  const user = await requireRole(request, "admin", env.API_URL);
  const token = getSessionToken(request);
  const api = createApiClient(env.API_URL, token);
  const shopId = user.role === "developer"
    ? new URL(request.url).searchParams.get("shopId")
    : user.shop_id;
  // ...
}
```

### Shop ID resolution (always use this pattern for admin routes)
```typescript
function resolveShopId(request, user, formShopId) {
  const url = new URL(request.url);
  if (user.role === "developer") {
    return formShopId?.trim() || url.searchParams.get("shopId")?.trim() || null;
  }
  return user.shop_id?.trim() || null;
}
```

