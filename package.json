{
  "name": "pivot-parlor",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "verify:live": "node scripts/verify-live.mjs",
    "reset:dev-password": "node scripts/reset-dev-password.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "dotenv": "^17.3.1",
    "prettier": "^3.7.4",
    "sharp": "0.35.5",
    "turbo": "^2.8.17",
    "typescript": "5.9.2",
    "undici": "7.30.2",
    "wrangler": "^4.154.0",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "miniflare": {
      "undici": "$undici",
      "sharp": "$sharp"
    },
    "@cloudflare/vitest-pool-workers": {
      "zod": "$zod"
    }
  },
  "packageManager": "npm@11.10.1",
  "workspaces": [
    "apps/*",
    "apps/workers/booking",
    "apps/workers/builder",
    "apps/workers/chatbot",
    "apps/workers/images",
    "apps/workers/research",
    "apps/workers/text",
    "apps/workers/uptime",
    "packages/*"
  ]
}
