  "triggers": {
    "audit_log_no_delete": "create trigger audit_log_no_delete before delete on audit_log when old.occurred_at > strftime('%Y-%m-%dT%H:%M:%fZ','now','-2192 days')begin select raise(abort,'audit_log is append-only'); end",
    "audit_log_seal_only": "create trigger audit_log_seal_only before update on audit_log when not(old.id is new.id and old.occurred_at is new.occurred_at and old.entry_hash is new.entry_hash and old.actor_type is new.actor_type and old.actor_ref is new.actor_ref and old.actor_role is new.actor_role and old.via is new.via and old.action is new.action and old.phase is new.phase and old.outcome is new.outcome and old.reason is new.reason and old.shop_id is new.shop_id and old.entity_type is new.entity_type and old.entity_id is new.entity_id and old.changes_json is new.changes_json and old.details_json is new.details_json and old.request_id is new.request_id and old.parent_id is new.parent_id and old.worker is new.worker and old.ip_ref is new.ip_ref and old.historical is new.historical and(old.seq is null or old.seq is new.seq)and(old.sealed_at is null or old.sealed_at is new.sealed_at)and(old.chain_hash is null or old.chain_hash is new.chain_hash)and(old.archived_at is null or old.archived_at is new.archived_at)and(old.archive_key is null or old.archive_key is new.archive_key))begin select raise(abort,'audit_log is append-only'); end"
