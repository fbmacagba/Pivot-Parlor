{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --config wrangler.dev.toml",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "lint": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node ../../scripts/migrate.mjs",
    "db:migrate:remote": "node ../../scripts/migrate.mjs --remote",
    "seed:dev": "tsx --tsconfig tsconfig.json scripts/seed-dev.ts"
  },
  "dependencies": {
    "@repo/types": "*",
    "hono": "^4.6.3",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.15",
    "@cloudflare/workers-types": "^4.20241022.0",
    "@repo/typescript-config": "*",
    "tsx": "^4.21.0",
    "typescript": "5.9.2",
    "vitest": "^4.1.8",
    "wrangler": "^4.74.0"
  }
}
