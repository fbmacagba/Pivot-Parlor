{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remix vite:dev",
    "predev": "node scripts/clean-app-js.mjs",
    "clean": "node scripts/clean-build.mjs",
    "clean:js": "node scripts/clean-app-js.mjs",
    "prebuild": "node scripts/clean-app-js.mjs",
    "build": "remix vite:build",
    "postbuild": "node scripts/copy-public.mjs",
    "start": "wrangler pages dev ./build/client",
    "deploy": "npm run clean && npm run build && node scripts/prepare-pages-deploy.mjs && node scripts/pages-deploy.mjs",
    "deploy:pages-client": "npm run build && npx wrangler pages deploy ./build/client --project-name=pivot-parlor-web --commit-dirty=true",
    "deploy:preview": "npm run clean && npm run build && node scripts/prepare-pages-deploy.mjs && npx wrangler pages deploy ./.pages-dist --project-name=pivot-parlor-web --commit-dirty=true",
    "typecheck": "tsc",
    "check-types": "tsc",
    "lint": "eslint --max-warnings 0 app"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jost": "^5.2.8",
    "@fontsource/libre-baskerville": "^5.2.10",
    "@fontsource/lora": "^5.2.8",
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/playfair-display": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@fontsource/work-sans": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@remix-run/cloudflare": "^2.15.3",
    "@remix-run/cloudflare-pages": "^2.15.3",
    "@remix-run/react": "^2.15.3",
    "@repo/types": "*",
    "@repo/utils": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^4.4.0",
    "lucide-react": "^0.447.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-qr-code": "^2.2.0",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "@remix-run/dev": "^2.15.3",
    "@repo/eslint-config": "*",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.2",
    "vite": "^5.4.10",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^4.0.0"
  }
}
